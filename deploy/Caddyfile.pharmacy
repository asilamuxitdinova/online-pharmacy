# Site block for pharmacy.sukoon.uz. Add it to the server's existing Caddyfile
# (or `import` this file from it); it does not touch any other site.
# Caddy obtains and renews the TLS certificate by itself.
#
# 127.0.0.1:8090 must match ADDR in /etc/frege-pharmacy/pharmacy.env.

pharmacy.sukoon.uz {
	encode zstd gzip

	# The API. PUBLIC_URL is https://pharmacy.sukoon.uz/api, so this is the
	# address in the OpenAPI spec and the one Frege calls.
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8090 {
			# Signed partner requests sign the path the client sent, /api included.
			header_up X-Forwarded-Prefix /api
		}
	}

	# Pages the backend renders itself, whose links and forms use these paths.
	@backend path /oauth/authorize /oauth/token /docs /docs/* /openapi.yaml
	handle @backend {
		reverse_proxy 127.0.0.1:8090
	}

	# The frontend: a single-page app, so unknown paths fall back to index.html.
	handle {
		root * /opt/frege-pharmacy/current/web
		# Hashed asset names never change; everything else (index.html) must be revalidated.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/pharmacy.sukoon.uz.log
	}
}
