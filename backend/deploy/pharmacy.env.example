# Test Pharmacy settings. Installed as /etc/frege-pharmacy/pharmacy.env (mode 0640).
# Every value here is for a test system. Replace every "change-me".

ADDR=127.0.0.1:8090
# The one https address written into the OpenAPI spec. Frege only sends
# credentials to this address, so it must match how Frege reaches the API.
PUBLIC_URL=https://pharmacy.example.test
DATABASE_PATH=/var/lib/frege-pharmacy/pharmacy.db

JWT_SECRET=change-me-long-random-string
# 60s makes token renewal visible within a minute; the default is 15m.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=true

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT=5m
OTP_TTL=5m
# Set to a 6-digit value for predictable scripted demos; empty sends random codes.
FIXED_OTP_CODE=

OAUTH_CLIENT_ID=partner-app
OAUTH_CLIENT_SECRET=change-me
# Comma-separated. Empty accepts any https redirect (convenient while testing).
OAUTH_REDIRECT_URIS=

PARTNER_CLIENT_ID=partner-demo
PARTNER_SECRET=change-me
SIGNATURE_SKEW=5m

WEBHOOK_SECRET=change-me
# When set, order.paid and refund.approved events are POSTed here, signed.
WEBHOOK_URL=

AUTO_REFUND_LIMIT=200000
FREE_DELIVERY_THRESHOLD=300000
DELIVERY_FEE=25000
JOB_DURATION=15s

# /_test/* helpers (inbox, reset, webhook receiver). Keep on for a test system.
TEST_HELPERS=true
# When set, POST /_test/reset needs the header X-Test-Token with this value.
TEST_RESET_TOKEN=
